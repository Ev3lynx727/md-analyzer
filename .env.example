# md-analyzer Environment Variables
# Copy this file to .env and configure as needed

# Path to md-analyzer.js (default: md-analyzer.js)
MD_ANALYZER_PATH=

# Default directory to scan (default: .)
MD_ANALYZER_DEFAULT_DIR=

# Max token limit for budget (default: 200000)
MD_ANALYZER_MAX_TOKENS=

# Default budget for sessions (default: 100000)
MD_ANALYZER_DEFAULT_BUDGET=

# Max results to return (default: 20)
MD_ANALYZER_MAX_RESULTS=
