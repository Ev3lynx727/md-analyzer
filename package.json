{
  "name": "@ev3lynx/md-analyzer",
  "version": "0.2.2",
  "description": "Markdown document analyzer for AI agents - extract metadata, headings, links, tables, tokens, and key points",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core/*": {
      "types": "./dist/core/*.d.ts",
      "default": "./dist/core/*.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/types/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "md-analyzer": "dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "prepublish": "npm run build",
    "test": "node dist/cli/index.js . --json",
    "ci": "npm run build && npm run typecheck && npm run lint && npm test"
  },
  "keywords": [
    "markdown",
    "analyzer",
    "ai-agents",
    "tokens",
    "document-analysis",
    "metadata",
    "graph"
  ],
  "author": "ev3lynx",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ev3lynx727/md-analyzer.git"
  },
  "bugs": {
    "url": "https://github.com/Ev3lynx727/md-analyzer/issues"
  },
  "homepage": "https://github.com/Ev3lynx727/md-analyzer#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "js-tiktoken": "^1.0.0",
    "js-yaml": "^4.2.0",
    "micromark": "^4.0.0",
    "micromark-extension-gfm": "^3.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.0.0",
    "eslint": "^10.4.1",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.60.1"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ]
}
