{
  "name": "@ev3lynx/md-analyzer",
  "version": "0.1.3",
  "description": "Markdown document analyzer for AI agents - extract metadata, headings, links, tables, tokens, and key points",
  "main": "md-analyzer.js",
  "bin": {
    "md-analyzer": "md-analyzer.js"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "prepublish": "npm run build",
    "test": "node md-analyzer.js . --json"
  },
  "keywords": [
    "markdown",
    "analyzer",
    "ai-agents",
    "tokens",
    "document-analysis",
    "metadata",
    "graph"
  ],
  "author": "ev3lynx",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ev3lynx727/md-analyzer.git"
  },
  "bugs": {
    "url": "https://github.com/Ev3lynx727/md-analyzer/issues"
  },
  "homepage": "https://github.com/Ev3lynx727/md-analyzer#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "js-tiktoken": "^1.0.0",
    "js-yaml": "^4.2.0",
    "micromark": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.0.0",
    "eslint": "^10.4.1",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.60.1"
  },
  "files": [
    "md-analyzer.js",
    "src/",
    "hooks.toml",
    "config.yaml",
    "README.md",
    "LICENSE",
    ".env.example"
  ]
}
